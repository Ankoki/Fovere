  m_Script: {fileID: 11500000, guid: fcd19b51b53d4f5a91a947cf67c81c88, type: 3}
  m_Name: StartingConversation
  m_EditorClassIdentifier: Assembly-CSharp::Fovere.DialogueData
  conversationBlock:
  - "Hello! <pause=0.5>Welcome to Fov\u0113re, <pause=0.5>our life-simulation game!
    <pause=0.5>You're currently in a dialogue, <pause=0.5>to progress, <pause=0.5>press
    E!"
  - There you go! <pause=0.5>This prototype is very bare bones, <pause=0.5>and demonstrates
    some basic systems we have in play.
  - Each resident here will tell you about a different system, <pause=0.5>whether
    included or not. <pause=0.5>To speak to them, <pause=0.5>approach them and press
    E! <pause=0.5>You'll get a prompt when you're close enough.
  - Enjoy exploring and interacting with the residents! <pause=0.5>They can't wait
    to tell you more about it here!
